# backend 环境变量示例：复制为 .env 后按需修改
# 未设置的项会自动回退到项目根目录的 config.json

# ---- 服务自身 ----
HOST=127.0.0.1
PORT=8000
# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 内部访问令牌；留空=不校验（仅建议本地开发时留空）
API_TOKEN=

# ---- LLM（优先级高于 config.json 的 llm 段）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120

# ---- PostgreSQL（优先级高于 config.json 的 pg 段）----
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PWD=
PG_DB=

# ---- 阿里云 OSS（优先级高于 config.json 的 oss 段）----
OSS_BUCKET=
OSS_AK=
OSS_SK=
OSS_ENDPOINT=

# ---- 飞书网页扫码登录 ----
# 在飞书开放平台「开发者后台 → 你的应用 → 凭证与基础信息」获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须与开放平台「安全设置 → 重定向 URL」里登记的一字不差
FEISHU_REDIRECT_URI=http://localhost:3000/auth/feishu/callback
# 会话有效期（小时），默认 168 = 7 天
FEISHU_SESSION_HOURS=168
